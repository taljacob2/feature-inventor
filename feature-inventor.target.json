{
  "schemaVersion": 1,
  "repository": {
    "url": "https://github.com/taljacob2/feature-inventor.git",
    "defaultBranch": "master"
  },
  "goals": [
    "Make autonomous improvement runs bounded, reproducible, and evidence-backed",
    "Make one-repository operation understandable before adding broader automation"
  ],
  "requiredChecks": ["npm test", "npm run build"],
  "protectedPaths": [".github/workflows/**", "infra/**"],
  "reviewPolicy": {
    "maxFilesChanged": 12,
    "humanApprovalRequired": true
  },
  "verificationPolicy": {
    "riskTagChecks": {
      "lifecycle-state": ["npm test", "npm run build"],
      "immutable-artifact": ["npm test"],
      "verification-evidence": ["npm test"],
      "finalization-gate": ["npm run build"]
    },
    "protectedPathChecks": ["npm run build"],
    "manualReviewRiskTags": ["external-runtime", "governance-policy", "finalization-gate"],
    "manualReviewProtectedPaths": true
  },
  "schedule": { "mode": "manual" },
  "indexing": {
    "enabled": true,
    "historyDays": 90,
    "defaultContextPack": "change",
    "maxEstimatedTokens": 4000,
    "includeGovernedArtifacts": true
  }
}
