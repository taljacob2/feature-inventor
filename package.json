{
  "name": "feature-inventor",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "author": "taljacob2",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "description": "A governed, evidence-backed autonomous improvement harness for one repository at a time.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taljacob2/feature-inventor.git"
  },
  "homepage": "https://github.com/taljacob2/feature-inventor#readme",
  "bugs": {
    "url": "https://github.com/taljacob2/feature-inventor/issues"
  },
  "keywords": [
    "cli",
    "developer-tools",
    "governance",
    "ai-agents",
    "repository-automation"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "ARCHITECTURE.md",
    "INDEX.md",
    "RELEASING.md",
    "LICENSE",
    "docs/cli"
  ],
  "bin": {
    "feature-inventor": "dist/cli.js"
  },
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && tsc",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "prepack": "npm run build",
    "pack:check": "npm pack --dry-run --json",
    "release:validate": "node scripts/release-validate.mjs",
    "release:artifacts": "node scripts/build-release-artifacts.mjs",
    "release:version": "node scripts/prepare-release-version.mjs",
    "release:prepare": "npm run build && npm test && npm run release:validate",
    "release:dry-run": "npm run release:prepare && npm run release:artifacts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "typescript": "^5.7.0",
    "yaml": "^2.9.0"
  }
}
